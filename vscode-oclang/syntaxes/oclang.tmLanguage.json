{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "oclang",
  "scopeName": "source.oc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#template-string" },
    { "include": "#string" },
    { "include": "#asm-block" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#ptr-type" },
    { "include": "#operators" },
    {
      "name": "variable.other.oc",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.oc",
          "match": "//.*$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.oc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.oc",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "template-string": {
      "name": "string.quoted.template.oc",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.oc",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.oc",
          "begin": "\\$\\{",
          "end": "\\}",
          "contentName": "source.oc.embedded",
          "patterns": [
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#literals" },
            { "include": "#operators" },
            {
              "name": "variable.other.oc",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "asm-block": {
      "name": "meta.asm.oc",
      "begin": "\\b(__asm)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "storage.type.asm.oc" }
      },
      "patterns": [
        {
          "name": "comment.line.oc",
          "match": "//.*$"
        },
        {
          "name": "comment.line.oc",
          "match": ";.*$"
        },
        {
          "name": "entity.name.label.oc",
          "match": "\\.?[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "keyword.control.oc",
          "match": "\\b(mov|add|sub|mul|imul|div|idiv|cmp|test|jmp|jz|jnz|je|jne|jl|jg|jle|jge|call|ret|push|pop|lea|xor|and|or|neg|inc|dec|cdq|movzx|movsd|addsd|subsd|mulsd|divsd|cvttsd2si|cvtsi2sd|cvtss2sd|cvtsd2ss|testpd|andpd)\\b"
        },
        {
          "name": "variable.other.register.oc",
          "match": "\\b(rax|rbx|rcx|rdx|rsi|rdi|rbp|rsp|r8|r9|r10|r11|r12|r13|r14|r15|eax|ebx|ecx|edx|esi|edi|ebp|esp|r8d|r9d|al|bl|cl|dl|sil|dil|xmm0|xmm1)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.oc",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.oc",
          "match": "\\b\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.oc",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oc",
          "match": "\\b(function|return|const|let|if|else|for|while|module|import|type|enum|sizeof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.oc",
          "match": "\\b(int|uint|byte|ubyte|short|ushort|long|ulong|single|double|void|string)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.oc",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.oc",
          "match": "\\bnull\\b"
        }
      ]
    },
    "ptr-type": {
      "name": "storage.type.ptr.oc",
      "begin": "\\bptr\\s*<",
      "end": ">",
      "beginCaptures": {
        "0": { "name": "storage.type.ptr.oc" }
      },
      "patterns": [
        { "include": "#types" },
        {
          "name": "entity.name.type.oc",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.oc",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.increment-decrement.oc",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.comparison.oc",
          "match": "(==|!=|<=|>=)"
        },
        {
          "name": "keyword.operator.logical.oc",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.assignment.oc",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.oc",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.oc",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.logical.oc",
          "match": "!"
        },
        {
          "name": "keyword.operator.address.oc",
          "match": "@"
        },
        {
          "name": "keyword.operator.dereference.oc",
          "match": "\\*(?![*/])"
        },
        {
          "name": "punctuation.separator.oc",
          "match": "[.,;:]"
        },
        {
          "name": "punctuation.definition.bracket.oc",
          "match": "[\\[\\]{}()<>]"
        },
        {
          "name": "punctuation.accessor.oc",
          "match": "\\."
        }
      ]
    }
  }
}
