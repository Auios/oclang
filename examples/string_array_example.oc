// string_array_example.oc - Array of strings with for loop
import("../lib/stdlib.oc", [process]);

function main(): int {
  const names: string[] = ["Alice", "Bob", "Carol"];
  const lengths: int[] = [5, 3, 5];

  for (let i: int = 0; i < names.length; i++) {
    process.write(1, ` ${i}: `);
    process._write_string(0 - 11, names[i], lengths[i]);
    process.write(1, "\n");
  }

  return 0;
}
